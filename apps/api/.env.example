GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# For Neon or Render Postgres paste the connection string as given (postgresql://...?sslmode=require);
# it is switched to the psycopg driver automatically.
DATABASE_URL=postgresql+psycopg://signposted:signposted@localhost:5432/signposted
# Comma-separated browser origins allowed to call the API directly. Not needed behind the web proxy.
CORS_ORIGINS=
